# Nostrum Dream Spaces - Environment Configuration Template
# Copy this file to .env and update the values

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Email Configuration (for contact forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
FROM_EMAIL=info@nostrumdreamspaces.com
TO_EMAIL=projects@nostrumdreamspaces.com

# Contact Information
COMPANY_NAME=Nostrum Dream Spaces
COMPANY_TAGLINE=Designing Dreams. Building Reality.
COMPANY_PHONE_1=+91 98765 43210
COMPANY_PHONE_2=+91 87654 32109
COMPANY_EMAIL_1=info@nostrumdreamspaces.com
COMPANY_EMAIL_2=projects@nostrumdreamspaces.com
COMPANY_ADDRESS=123 Design Street, Premium Plaza, Mumbai, Maharashtra 400001
COMPANY_WEBSITE=https://www.nostrumdreamspaces.com

# Business Hours
BUSINESS_HOURS_WEEKDAY=9:00 AM - 7:00 PM
BUSINESS_HOURS_WEEKEND=10:00 AM - 5:00 PM

# Social Media Links
FACEBOOK_URL=https://facebook.com/nostrumdreamspaces
INSTAGRAM_URL=https://instagram.com/nostrumdreamspaces
LINKEDIN_URL=https://linkedin.com/company/nostrum-dream-spaces
YOUTUBE_URL=https://youtube.com/@nostrumdreamspaces
PINTEREST_URL=https://pinterest.com/nostrumdreamspaces
TWITTER_URL=https://twitter.com/nostrumdreamspaces

# WhatsApp Configuration
WHATSAPP_NUMBER=919876543210
WHATSAPP_MESSAGE=Hello! I'm interested in your design services.

# Google Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx
UPLOAD_PATH=./uploads

# Security Configuration
SESSION_SECRET=your_super_secret_session_key_here
JWT_SECRET=your_jwt_secret_key_here
BCRYPT_ROUNDS=12

# SEO Configuration
SITE_NAME=Nostrum Dream Spaces
SITE_DESCRIPTION=Premium Interior Design, Exterior Design, Construction & Turnkey Solutions. Designing Dreams. Building Reality.
SITE_KEYWORDS=interior design, exterior design, construction, turnkey projects, modular kitchen, renovation, premium design, Mumbai
SITE_AUTHOR=Nostrum Dream Spaces
SITE_URL=https://www.nostrumdreamspaces.com

# Development Settings
DEBUG=true
ENABLE_LOGGING=true
ENABLE_COMPRESSION=true
ENABLE_CORS=true