                    <span class="section-label">Modular Excellence</span>
                    <h2 class="section-title">Custom Modular Solutions</h2>
                    <p class="section-description">
                        Our modular works include custom-designed kitchens, wardrobes, and furniture that 
                        maximize space utilization while maintaining aesthetic appeal. We create functional 
                        and stylish modular solutions for modern homes and offices.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <i class="fas fa-ruler-combined"></i>
                            <div>
                                <h4>Space Optimization</h4>
                                <p>Intelligent design solutions that maximize every inch of space</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-cogs"></i>
                            <div>
                                <h4>Custom Manufacturing</h4>
                                <p>Precision-made modular units tailored to your specific requirements</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-gem"></i>
                            <div>
                                <h4>Premium Materials</h4>
                                <p>High-quality materials and finishes for durability and beauty</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="service-image scroll-animate-right">
                    <img src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Modern Modular Kitchen" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Service Types -->
<section class="service-types section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Specializations</span>
            <h2 class="section-title">Modular Solutions We Offer</h2>
            <p class="section-description">
                Complete range of modular furniture and storage solutions
            </p>
        </div>
        
        <div class="service-types-grid">
            <div class="service-type-card scroll-animate">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Modular Kitchen">
                </div>
                <div class="service-type-content">
                    <h3>Modular Kitchens</h3>
                    <p>Custom-designed modular kitchens with smart storage solutions, premium appliances, and elegant finishes.</p>
                    <ul class="service-type-features">
                        <li>L-Shaped Kitchens</li>
                        <li>U-Shaped Kitchens</li>
                        <li>Island Kitchens</li>
                        <li>Parallel Kitchens</li>
                        <li>Straight Kitchens</li>
                    </ul>
                </div>
            </div>
            
            <div class="service-type-card scroll-animate delay-1">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Modular Wardrobes">
                </div>
                <div class="service-type-content">
                    <h3>Modular Wardrobes</h3>
                    <p>Spacious and organized wardrobe solutions with customizable compartments and modern accessories.</p>
                    <ul class="service-type-features">
                        <li>Walk-in Wardrobes</li>
                        <li>Sliding Door Wardrobes</li>
                        <li>Hinged Door Wardrobes</li>
                        <li>Corner Wardrobes</li>
                        <li>Built-in Storage</li>
                    </ul>
                </div>
            </div>
            
            <div class="service-type-card scroll-animate delay-2">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Custom Furniture">
                </div>
                <div class="service-type-content">
                    <h3>Custom Furniture</h3>
                    <p>Bespoke furniture pieces designed to fit your space perfectly and match your interior design theme.</p>
                    <ul class="service-type-features">
                        <li>TV Units & Entertainment Centers</li>
                        <li>Study Tables & Workstations</li>
                        <li>Dining Tables & Chairs</li>
                        <li>Bed Frames & Headboards</li>
                        <li>Storage Solutions</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

