<!-- Features & Benefits -->
<section class="features-benefits section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Why Choose Modular</span>
            <h2 class="section-title">Benefits of Modular Solutions</h2>
        </div>
        
        <div class="benefits-grid">
            <div class="benefit-card scroll-animate">
                <div class="benefit-icon">
                    <i class="fas fa-puzzle-piece"></i>
                </div>
                <h4>Flexible Design</h4>
                <p>Modular components can be reconfigured and expanded as needed</p>
            </div>
            
            <div class="benefit-card scroll-animate delay-1">
                <div class="benefit-icon">
                    <i class="fas fa-clock"></i>
                </div>
                <h4>Quick Installation</h4>
                <p>Faster installation compared to traditional carpentry work</p>
            </div>
            
            <div class="benefit-card scroll-animate delay-2">
                <div class="benefit-icon">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <h4>Cost Effective</h4>
                <p>Better value for money with standardized manufacturing processes</p>
            </div>
            
            <div class="benefit-card scroll-animate delay-3">
                <div class="benefit-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <h4>Easy Maintenance</h4>
                <p>Individual components can be easily replaced or repaired</p>
            </div>
            
            <div class="benefit-card scroll-animate delay-4">
                <div class="benefit-icon">
                    <i class="fas fa-leaf"></i>
                </div>
                <h4>Eco-Friendly</h4>
                <p>Sustainable materials and minimal waste during manufacturing</p>
            </div>
            
            <div class="benefit-card scroll-animate delay-5">
                <div class="benefit-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h4>Quality Assured</h4>
                <p>Factory-made components ensure consistent quality and finish</p>
            </div>
        </div>
    </div>
</section>

