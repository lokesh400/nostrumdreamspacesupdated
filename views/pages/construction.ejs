<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us || Nostrum Dream Spaces</title>
    <meta name="description"
        content="Nostrum Dream Spaces - Premium Interior Design, Exterior Design, Construction & Turnkey Solutions. Designing Dreams. Building Reality.">
    <meta name="keywords"
        content="interior design, exterior design, construction, turnkey projects, modular kitchen, renovation, premium design">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Styles -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/animations.css">
    <link rel="stylesheet" href="/css/responsive.css">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body style="width: 100%;">

    <%- include('../partials/header.ejs') %>
<section class="page-header section-padding bg-dark text-white" style="margin-top: 75px;">
    <div class="container">
        <div class="page-header-content text-center">
            <h1 class="page-title animate-fade-up">Construction & Turnkey Projects</h1>
            <p class="page-subtitle animate-fade-up delay-1">Complete construction solutions from foundation to finishing</p>
            <nav class="breadcrumb animate-fade-up delay-2">
                <a href="/">Home</a> / <a href="/services">Services</a> / <span>Construction & Turnkey</span>
            </nav>
        </div>
    </div>
</section>

<!-- Service Overview -->
<section class="service-overview section-padding">
    <div class="container">
        <div class="row align-center">
            <div class="col-lg-6">
                <div class="service-content scroll-animate-left">
                    <span class="section-label">Construction Excellence</span>
                    <h2 class="section-title">End-to-End Construction Solutions</h2>
                    <p class="section-description">
                        Our construction and turnkey services provide complete building solutions from initial 
                        planning to final handover. We handle every aspect of construction with precision, 
                        quality, and adherence to timelines.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <i class="fas fa-hard-hat"></i>
                            <div>
                                <h4>Expert Project Management</h4>
                                <p>Experienced project managers ensuring smooth execution</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <h4>Quality Assurance</h4>
                                <p>Rigorous quality checks at every stage of construction</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-calendar-check"></i>
                            <div>
                                <h4>Timely Delivery</h4>
                                <p>Projects completed on schedule with no compromise on quality</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="service-image scroll-animate-right">
                    <img src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Construction Site" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Service Types -->
<section class="service-types section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Specializations</span>
            <h2 class="section-title">Construction Services We Offer</h2>
            <p class="section-description">
                Comprehensive construction solutions for residential and commercial projects
            </p>
        </div>
        
        <div class="service-types-grid">
            <div class="service-type-card scroll-animate">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Residential Construction">
                </div>
                <div class="service-type-content">
                    <h3>Residential Construction</h3>
                    <p>Complete home construction services from foundation to finishing, including villas, apartments, and custom homes.</p>
                    <ul class="service-type-features">
                        <li>Villa Construction</li>
                        <li>Apartment Buildings</li>
                        <li>Custom Home Building</li>
                        <li>Row Houses</li>
                        <li>Duplex Construction</li>
                    </ul>
                </div>
            </div>
            
            <div class="service-type-card scroll-animate delay-1">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Commercial Construction">
                </div>
                <div class="service-type-content">
                    <h3>Commercial Construction</h3>
                    <p>Professional commercial building construction for offices, retail spaces, and industrial facilities.</p>
                    <ul class="service-type-features">
                        <li>Office Buildings</li>
                        <li>Retail Complexes</li>
                        <li>Warehouses</li>
                        <li>Hotels & Restaurants</li>
                        <li>Industrial Facilities</li>
                    </ul>
                </div>
            </div>
            
            <div class="service-type-card scroll-animate delay-2">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Turnkey Projects">
                </div>
                <div class="service-type-content">
                    <h3>Turnkey Projects</h3>
                    <p>Complete turnkey solutions where we handle everything from design to handover, providing a hassle-free experience.</p>
                    <ul class="service-type-features">
                        <li>Design & Build</li>
                        <li>Project Planning</li>
                        <li>Construction Management</li>
                        <li>Interior Finishing</li>
                        <li>Final Handover</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Construction Process -->
<section class="construction-process section-padding">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Process</span>
            <h2 class="section-title">Construction Project Workflow</h2>
        </div>
        
        <div class="process-timeline">
            <div class="timeline-item scroll-animate">
                <div class="timeline-marker">
                    <span class="step-number">01</span>
                </div>
                <div class="timeline-content">
                    <h4>Project Planning</h4>
                    <p>Detailed project planning, site analysis, and architectural design development.</p>
                </div>
            </div>
            
            <div class="timeline-item scroll-animate delay-1">
                <div class="timeline-marker">
                    <span class="step-number">02</span>
                </div>
                <div class="timeline-content">
                    <h4>Permits & Approvals</h4>
                    <p>Obtaining necessary permits, approvals, and regulatory clearances.</p>
                </div>
            </div>
            
            <div class="timeline-item scroll-animate delay-2">
                <div class="timeline-marker">
                    <span class="step-number">03</span>
                </div>
                <div class="timeline-content">
                    <h4>Foundation Work</h4>
                    <p>Site preparation, excavation, and foundation construction with quality materials.</p>
                </div>
            </div>
            
            <div class="timeline-item scroll-animate delay-3">
                <div class="timeline-marker">
                    <span class="step-number">04</span>
                </div>
                <div class="timeline-content">
                    <h4>Structural Construction</h4>
                    <p>Building the main structure including walls, columns, beams, and roofing.</p>
                </div>
            </div>
            
            <div class="timeline-item scroll-animate delay-4">
                <div class="timeline-marker">
                    <span class="step-number">05</span>
                </div>
                <div class="timeline-content">
                    <h4>MEP Installation</h4>
                    <p>Mechanical, electrical, and plumbing systems installation and testing.</p>
                </div>
            </div>
            
            <div class="timeline-item scroll-animate delay-5">
                <div class="timeline-marker">
                    <span class="step-number">06</span>
                </div>
                <div class="timeline-content">
                    <h4>Finishing & Handover</h4>
                    <p>Interior finishing, final inspections, and project handover with documentation.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Quality Standards -->
<section class="quality-standards section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Quality Assurance</span>
            <h2 class="section-title">Our Construction Standards</h2>
        </div>
        
        <div class="standards-grid">
            <div class="standard-card scroll-animate">
                <div class="standard-icon">
                    <i class="fas fa-certificate"></i>
                </div>
                <h4>IS Code Compliance</h4>
                <p>All construction follows Indian Standard codes and building regulations</p>
            </div>
            
            <div class="standard-card scroll-animate delay-1">
                <div class="standard-icon">
                    <i class="fas fa-microscope"></i>
                </div>
                <h4>Material Testing</h4>
                <p>Rigorous testing of all construction materials for quality and durability</p>
            </div>
            
            <div class="standard-card scroll-animate delay-2">
                <div class="standard-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <h4>Regular Inspections</h4>
                <p>Daily quality inspections and progress monitoring by expert supervisors</p>
            </div>
            
            <div class="standard-card scroll-animate delay-3">
                <div class="standard-icon">
                    <i class="fas fa-award"></i>
                </div>
                <h4>Warranty Coverage</h4>
                <p>Comprehensive warranty on structural work and construction quality</p>
            </div>
        </div>
    </div>
</section>

<!-- Portfolio Gallery -->
<section class="portfolio-gallery section-padding">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Projects</span>
            <h2 class="section-title">Construction Portfolio</h2>
            <p class="section-description">
                Explore our completed construction and turnkey projects
            </p>
        </div>
        
        <div class="portfolio-grid">
            <div class="portfolio-item scroll-animate">
                <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Residential Villa Construction">
                <div class="portfolio-overlay">
                    <h4>Luxury Villa Project</h4>
                    <p>Complete villa construction with modern amenities</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-1">
                <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Commercial Building Construction">
                <div class="portfolio-overlay">
                    <h4>Office Complex</h4>
                    <p>Multi-story commercial building project</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-2">
                <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Apartment Construction">
                <div class="portfolio-overlay">
                    <h4>Apartment Complex</h4>
                    <p>Residential apartment building construction</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-3">
                <img src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Turnkey Project">
                <div class="portfolio-overlay">
                    <h4>Turnkey Project</h4>
                    <p>Complete design-build solution</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section section-padding bg-primary text-white">
    <div class="container">
        <div class="cta-content text-center">
            <h2>Ready to Start Your Construction Project?</h2>
            <p>Let's build your dream project with quality construction and timely delivery.</p>
            <div class="cta-buttons">
                <a href="/quote" class="btn btn-white btn-large">Get Free Quote</a>
                <a href="/contact" class="btn btn-outline-white btn-large">Schedule Consultation</a>
            </div>
        </div>
    </div>
</section>

        <%- include('../partials/footer.ejs') %>

            <script src="/js/main.js"></script>
            <script src="/js/animations.js"></script>
</body>

</html>