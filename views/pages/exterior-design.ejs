<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nostrum Dream Spaces</title>
    <meta name="description"
        content="Nostrum Dream Spaces - Premium Interior Design, Exterior Design, Construction & Turnkey Solutions. Designing Dreams. Building Reality.">
    <meta name="keywords"
        content="interior design, exterior design, construction, turnkey projects, modular kitchen, renovation, premium design">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Styles -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/animations.css">
    <link rel="stylesheet" href="/css/responsive.css">

    <!-- Favicon -->
        <link rel="icon" type="image/x-icon" href="/images/icon.png">
</head>

<body style="width: 100%;">

    <%- include('../partials/header.ejs') %>
<section class="page-header section-padding bg-dark text-white" style="margin-top: 75px;">
    <div class="container">
        <div class="page-header-content text-center">
            <h1 class="page-title animate-fade-up">Exterior Design Services</h1>
            <p class="page-subtitle animate-fade-up delay-1">Create stunning facades and elevations that make lasting impressions</p>
            <nav class="breadcrumb animate-fade-up delay-2">
                <a href="/">Home</a> / <a href="/services">Services</a> / <span>Exterior Design</span>
            </nav>
        </div>
    </div>
</section>

<!-- Service Overview -->
<section class="service-overview section-padding">
    <div class="container">
        <div class="row align-center">
            <div class="col-lg-6">
                <div class="service-content scroll-animate-left">
                    <span class="section-label">Exterior Design Excellence</span>
                    <h2 class="section-title">Stunning Facades & Elevation Design</h2>
                    <p class="section-description">
                        Our exterior design services focus on creating impressive building facades and elevations 
                        that enhance curb appeal and architectural beauty. From residential homes to commercial 
                        buildings, we design exteriors that stand out.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <i class="fas fa-building"></i>
                            <div>
                                <h4>Architectural Excellence</h4>
                                <p>Innovative facade designs that complement architectural styles</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-leaf"></i>
                            <div>
                                <h4>Sustainable Materials</h4>
                                <p>Eco-friendly and durable materials for long-lasting beauty</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-lightbulb"></i>
                            <div>
                                <h4>Lighting Integration</h4>
                                <p>Strategic lighting design to enhance nighttime aesthetics</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="service-image scroll-animate-right">
                    <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Modern Building Exterior" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Service Types -->
<section class="service-types section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Specializations</span>
            <h2 class="section-title">Exterior Design Services We Offer</h2>
            <p class="section-description">
                Comprehensive exterior design solutions for every building type
            </p>
        </div>
        
        <div class="service-types-grid">
            <div class="service-type-card scroll-animate">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Residential Exterior Design">
                </div>
                <div class="service-type-content">
                    <h3>Residential Exterior Design</h3>
                    <p>Beautiful home exteriors that enhance curb appeal and property value with modern and traditional design elements.</p>
                    <ul class="service-type-features">
                        <li>Villa Facade Design</li>
                        <li>Apartment Elevation</li>
                        <li>Garden & Landscape Integration</li>
                        <li>Entrance Design</li>
                        <li>Balcony & Terrace Design</li>
                    </ul>
                </div>
            </div>
            
            <div class="service-type-card scroll-animate delay-1">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Commercial Exterior Design">
                </div>
                <div class="service-type-content">
                    <h3>Commercial Exterior Design</h3>
                    <p>Professional building exteriors that create strong brand presence and impressive business facades.</p>
                    <ul class="service-type-features">
                        <li>Office Building Facade</li>
                        <li>Retail Store Exterior</li>
                        <li>Restaurant Facade</li>
                        <li>Hotel Exterior Design</li>
                        <li>Industrial Building Design</li>
                    </ul>
                </div>
            </div>
            
            <div class="service-type-card scroll-animate delay-2">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Facade Renovation">
                </div>
                <div class="service-type-content">
                    <h3>Facade Renovation</h3>
                    <p>Transform existing building exteriors with modern materials and contemporary design approaches.</p>
                    <ul class="service-type-features">
                        <li>Building Facade Upgrade</li>
                        <li>Material Replacement</li>
                        <li>Color Scheme Update</li>
                        <li>Lighting Enhancement</li>
                        <li>Structural Improvements</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Design Elements -->
<section class="design-elements section-padding">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Design Elements</span>
            <h2 class="section-title">Key Features of Our Exterior Designs</h2>
        </div>
        
        <div class="elements-grid">
            <div class="element-card scroll-animate">
                <div class="element-icon">
                    <i class="fas fa-palette"></i>
                </div>
                <h4>Color & Texture</h4>
                <p>Carefully selected color palettes and textures that create visual interest and harmony</p>
            </div>
            
            <div class="element-card scroll-animate delay-1">
                <div class="element-icon">
                    <i class="fas fa-cube"></i>
                </div>
                <h4>Material Selection</h4>
                <p>Premium materials including stone, glass, metal, and composite materials for durability</p>
            </div>
            
            <div class="element-card scroll-animate delay-2">
                <div class="element-icon">
                    <i class="fas fa-sun"></i>
                </div>
                <h4>Climate Consideration</h4>
                <p>Weather-resistant designs that perform well in local climate conditions</p>
            </div>
            
            <div class="element-card scroll-animate delay-3">
                <div class="element-icon">
                    <i class="fas fa-tree"></i>
                </div>
                <h4>Landscape Integration</h4>
                <p>Seamless integration with surrounding landscape and environment</p>
            </div>
        </div>
    </div>
</section>

<!-- Portfolio Gallery -->
<section class="portfolio-gallery section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Work</span>
            <h2 class="section-title">Exterior Design Portfolio</h2>
            <p class="section-description">
                Explore our collection of stunning exterior design projects
            </p>
        </div>
        
        <div class="portfolio-grid">
            <div class="portfolio-item scroll-animate">
                <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Modern House Exterior">
                <div class="portfolio-overlay">
                    <h4>Modern Villa Exterior</h4>
                    <p>Contemporary design with clean lines</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-1">
                <img src="https://images.unsplash.com/photo-1570129477492-45c003edd2be?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Luxury Home Facade">
                <div class="portfolio-overlay">
                    <h4>Luxury Home Facade</h4>
                    <p>Elegant residential exterior design</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-2">
                <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Commercial Building">
                <div class="portfolio-overlay">
                    <h4>Commercial Building</h4>
                    <p>Professional office exterior</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-3">
                <img src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Renovated Facade">
                <div class="portfolio-overlay">
                    <h4>Renovated Facade</h4>
                    <p>Modern facade renovation project</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section section-padding bg-primary text-white">
    <div class="container">
        <div class="cta-content text-center">
            <h2>Ready to Enhance Your Building's Exterior?</h2>
            <p>Let's create stunning facades and elevations that make your building stand out.</p>
            <div class="cta-buttons">
                <a href="/quote" class="btn btn-white btn-large">Get Free Quote</a>
                <a href="/contact" class="btn btn-outline-white btn-large">Schedule Consultation</a>
            </div>
        </div>
    </div>
</section>

        <%- include('../partials/footer.ejs') %>

            <script src="/js/main.js"></script>
            <script src="/js/animations.js"></script>
</body>

</html>