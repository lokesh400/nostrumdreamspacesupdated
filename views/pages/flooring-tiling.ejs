                <div class="portfolio-overlay">
                    <h4>Granite Flooring</h4>
                    <p>Durable granite flooring installation</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-2">
                <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Wooden Flooring">
                <div class="portfolio-overlay">
                    <h4>Wooden Flooring</h4>
                    <p>Elegant engineered wood flooring</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-3">
                <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Ceramic Tiles">
                <div class="portfolio-overlay">
                    <h4>Designer Tiles</h4>
