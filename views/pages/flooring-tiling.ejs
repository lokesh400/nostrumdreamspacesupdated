<body style="width: 100%;">

    <%- include('../partials/header.ejs') %>
<section class="page-header section-padding bg-dark text-white" style="margin-top: 75px;">
    <div class="container">
        <div class="page-header-content text-center">
            <h1 class="page-title animate-fade-up">Flooring & Tiling Services</h1>
            <p class="page-subtitle animate-fade-up delay-1">Premium flooring solutions for beautiful and durable surfaces</p>
            <nav class="breadcrumb animate-fade-up delay-2">
                <a href="/">Home</a> / <a href="/services">Services</a> / <span>Flooring & Tiling</span>
            </nav>
        </div>
    </div>
</section>

<!-- Service Overview -->
<section class="service-overview section-padding">
    <div class="container">
        <div class="row align-center">
            <div class="col-lg-6">
                <div class="service-content scroll-animate-left">
                    <span class="section-label">Flooring Excellence</span>
           <div class="section-title">Premium Flooring & Tiling Solutions</h2>
                    <p class="section-description">
                        Our flooring and tiling services offer a wide range of premium materials and 
                        professional installation. From marble and granite to ceramic tiles and wooden 
                        flooring, we create beautiful and durable surfaces for your spaces.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <i class="fas fa-gem"></i>
                            <div>
                                <h4>Premium Materials</h4>
                                <p>High-quality tiles, marble, granite, and wooden flooring options</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-tools"></i>
                            <div>
                                <h4>Expert Installation</h4>
                                <p>Professional installation by skilled craftsmen with precision</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <h4>Durability Guaranteed</h4>
                                <p>Long-lasting flooring solutions with comprehensive warranty</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="service-image scroll-animate-right">
                    <img src="https://images.unsplash.com/photo-1586105251261-72a756497a11?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Premium Flooring Installation" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Flooring Types -->
<section class="flooring-types section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Flooring Options</span>
            <h2 class="section-title">Types of Flooring We Offer</h2>
            <p class="section-description">
                Comprehensive range of flooring materials for every space and budget
            </p>
        </div>
        
        <div class="flooring-types-grid">
            <div class="flooring-type-card scroll-animate">
                <div class="flooring-type-image">
                    <img src="https://images.unsplash.com/photo-1615971677499-5467cbab01c0?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Marble Flooring">
                </div>
                <div class="flooring-type-content">
                    <h3>Marble Flooring</h3>
                    <p>Luxurious marble flooring with natural patterns and elegant finish for premium spaces.</p>
                    <ul class="flooring-features">
                        <li>Italian Marble</li>
                        <li>Indian Marble</li>
                        <li>Polished Finish</li>
                        <li>Custom Patterns</li>
                        <li>Border Designs</li>
                    </ul>
                </div>
            </div>
            
            <div class="flooring-type-card scroll-animate delay-1">
                <div class="flooring-type-image">
                    <img src="https://images.unsplash.com/photo-1586105251261-72a756497a11?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Granite Flooring">
                </div>
                <div class="flooring-type-content">
                    <h3>Granite Flooring</h3>
                    <p>Durable granite flooring with excellent resistance to wear and natural beauty.</p>
                    <ul class="flooring-features">
                        <li>Black Galaxy</li>
                        <li>Absolute Black</li>
                        <li>Kashmir White</li>
                        <li>Polished & Flamed</li>
                        <li>Anti-Slip Options</li>
                    </ul>
                </div>
            </div>
            
            <div class="flooring-type-card scroll-animate delay-2">
                <div class="flooring-type-image">
                    <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Wooden Flooring">
                </div>
                <div class="flooring-type-content">
                    <h3>Wooden Flooring</h3>
                    <p>Warm and elegant wooden flooring options including engineered wood and laminate.</p>
                    <ul class="flooring-features">
                        <li>Engineered Wood</li>
                        <li>Laminate Flooring</li>
                        <li>Vinyl Planks</li>
                        <li>Bamboo Flooring</li>
                        <li>Parquet Designs</li>
                    </ul>
                </div>
            </div>
            
            <div class="flooring-type-card scroll-animate delay-3">
                <div class="flooring-type-image">
                    <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Ceramic Tiles">
                </div>
                <div class="flooring-type-content">
                    <h3>Ceramic & Vitrified Tiles</h3>
                    <p>Versatile ceramic and vitrified tiles in various sizes, colors, and patterns.</p>
                    <ul class="flooring-features">
                        <li>Vitrified Tiles</li>
                        <li>Ceramic Tiles</li>
                        <li>Porcelain Tiles</li>
                        <li>Designer Patterns</li>
                        <li>Large Format Tiles</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Tile Applications -->
<section class="tile-applications section-padding">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Applications</span>
            <h2 class="section-title">Where We Install Flooring & Tiles</h2>
        </div>
        
        <div class="applications-grid">
            <div class="application-card scroll-animate">
                <div class="application-icon">
                    <i class="fas fa-home"></i>
                </div>
                <h4>Living Areas</h4>
                <p>Beautiful flooring for living rooms, dining areas, and family spaces</p>
            </div>
            
            <div class="application-card scroll-animate delay-1">
                <div class="application-icon">
                    <i class="fas fa-bed"></i>
                </div>
                <h4>Bedrooms</h4>
                <p>Comfortable and elegant flooring options for peaceful bedrooms</p>
            </div>
            
            <div class="application-card scroll-animate delay-2">
                <div class="application-icon">
                    <i class="fas fa-utensils"></i>
                </div>
                <h4>Kitchens</h4>
                <p>Durable and easy-to-clean flooring perfect for kitchen environments</p>
            </div>
            
            <div class="application-card scroll-animate delay-3">
                <div class="application-icon">
                    <i class="fas fa-bath"></i>
                </div>
                <h4>Bathrooms</h4>
                <p>Water-resistant and anti-slip flooring for safe bathroom spaces</p>
            </div>
            
            <div class="application-card scroll-animate delay-4">
                <div class="application-icon">
                    <i class="fas fa-building"></i>
                </div>
                <h4>Commercial Spaces</h4>
                <p>Heavy-duty flooring solutions for offices, shops, and commercial areas</p>
            </div>
            
            <div class="application-card scroll-animate delay-5">
                <div class="application-icon">
                    <i class="fas fa-tree"></i>
                </div>
                <h4>Outdoor Areas</h4>
                <p>Weather-resistant flooring for terraces, balconies, and outdoor spaces</p>
            </div>
        </div>
    </div>
</section>

<!-- Installation Process -->
<section class="installation-process section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Process</span>
            <h2 class="section-title">Professional Installation Process</h2>
        </div>
        
        <div class="process-steps">
            <div class="process-step scroll-animate">
                <div class="step-number">01</div>
                <div class="step-icon">
                    <i class="fas fa-ruler-combined"></i>
                </div>
                <h3>Site Measurement</h3>
                <p>Accurate measurement and assessment of the area to be floored.</p>
            </div>
            
            <div class="process-step scroll-animate delay-1">
                <div class="step-number">02</div>
                <div class="step-icon">
                    <i class="fas fa-palette"></i>
                </div>
                <h3>Material Selection</h3>
                <p>Choosing the right materials based on usage, budget, and design preferences.</p>
            </div>
            
            <div class="process-step scroll-animate delay-2">
                <div class="step-number">03</div>
                <div class="step-icon">
                    <i class="fas fa-hammer"></i>
                </div>
                <h3>Surface Preparation</h3>
                <p>Proper preparation of the base surface for optimal installation results.</p>
            </div>
            
            <div class="process-step scroll-animate delay-3">
                <div class="step-number">04</div>
                <div class="step-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <h3>Professional Installation</h3>
                <p>Expert installation using proper techniques and quality adhesives.</p>
            </div>
            
            <div class="process-step scroll-animate delay-4">
                <div class="step-number">05</div>
                <div class="step-icon">
                    <i class="fas fa-broom"></i>
                </div>
                <h3>Finishing & Cleaning</h3>
                <p>Final finishing touches, grouting, and thorough cleaning of the area.</p>
            </div>
            
            <div class="process-step scroll-animate delay-5">
                <div class="step-number">06</div>
                <div class="step-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h3>Quality Check</h3>
                <p>Final inspection and quality assurance before project handover.</p>
            </div>
        </div>
    </div>
</section>

