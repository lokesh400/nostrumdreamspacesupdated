<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us || Nostrum Dream Spaces</title>
    <meta name="description"
        content="Nostrum Dream Spaces - Premium Interior Design, Exterior Design, Construction & Turnkey Solutions. Designing Dreams. Building Reality.">
    <meta name="keywords"
        content="interior design, exterior design, construction, turnkey projects, modular kitchen, renovation, premium design">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Styles -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/animations.css">
    <link rel="stylesheet" href="/css/responsive.css">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/icon.png">
</head>

<body style="width: 100%;">
    <%- include('../partials/header.ejs') %>
    <section class="page-header section-padding bg-dark text-white"
        style="margin-top: 75px;">
        <div class="container">
            <div class="page-header-content text-center">
                <h1 class="page-title animate-fade-up">Interior Design Services
                </h1>
                <p class="page-subtitle animate-fade-up delay-1">Transform your
                    spaces with our premium interior design solutions</p>
                <nav class="breadcrumb animate-fade-up delay-2">
                    <a href="/">Home</a> / <a href="/services">Services</a> /
                    <span>Interior Design</span>
                </nav>
            </div>
        </div>
    </section>


    <!-- Service Overview -->
    <section class="service-overview section-padding">
        <div class="container">
            <div class="row align-center">
                <div class="col-lg-6">
                    <div class="service-content scroll-animate-left">
                        <span class="section-label">Interior Design
                            Excellence</span>
                        <h2 class="section-title">Creating Beautiful &
                            Functional Interiors</h2>
                        <p class="section-description">
                            Our interior design services combine aesthetics with
                            functionality to create spaces that
                            reflect your personality and lifestyle. From
                            residential homes to commercial offices,
                            we design interiors that inspire and delight.
                        </p>
                        <div class="service-features">
                            <div class="feature-item">
                                <i class="fas fa-palette"></i>
                                <div>
                                    <h4>Custom Design Solutions</h4>
                                    <p>Tailored designs that reflect your unique
                                        style and requirements</p>
                                </div>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-cube"></i>
                                <div>
                                    <h4>3D Visualization</h4>
                                    <p>Realistic 3D renderings to visualize your
                                        space before execution</p>
                                </div>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-clock"></i>
                                <div>
                                    <h4>Timely Completion</h4>
                                    <p>Projects completed on schedule with
                                        attention to every detail</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="service-image scroll-animate-right">
                        <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                            alt="Modern Interior Design" class="img-fluid">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Service Types -->
    <section class="service-types section-padding bg-light">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-label">Our Specializations</span>
                <h2 class="section-title">Interior Design Services We Offer</h2>
                <p class="section-description">
                    Comprehensive interior design solutions for every space and
                    requirement
                </p>
            </div>



            <section
                class="w-full bg-gradient-to-b from-gray-100 to-white py-24">
                <div class="max-w-7xl mx-auto px-4">

                    <!-- Heading -->
                    <div class="text-center mb-20">
                        <h2
                            class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                            Our Interior Services
                        </h2>
                        <div
                            class="w-24 h-1 bg-black mx-auto mb-6 rounded-full">
                        </div>
                        <p class="text-gray-600 max-w-2xl mx-auto text-lg">
                            Premium interior solutions crafted with creativity,
                            precision,
                            and modern design principles.
                        </p>
                    </div>

                    <!-- Grid -->
                    <div class="service-types-grid">
                        <% const services = [{
title: "Modular Kitchen Designing & Installation",
img: "https://images.pexels.com/photos/279608/pexels-photo-279608.jpeg"
},
{
title: "Wardrobe & Furniture Designing",
img: "https://images.pexels.com/photos/1866149/pexels-photo-1866149.jpeg"
},
{
title: "False Ceiling Designing",
img: "https://images.pexels.com/photos/271619/pexels-photo-271619.jpeg"
},
{
title: "Lighting Design & Automation",
img: "https://images.pexels.com/photos/776656/pexels-photo-776656.jpeg"
},
{
title: "Wall Paneling (WPC, MDF, PVC, Fabric, etc.)",
img: "https://images.pexels.com/photos/279719/pexels-photo-279719.jpeg"
},
{
title: "Floor Designing (Vinyl, Laminate, Wooden, Tiles)",
img: "https://images.pexels.com/photos/186077/pexels-photo-186077.jpeg"
},
{
title: "3D Interior Designing & Visualization",
img: "https://images.pexels.com/photos/271667/pexels-photo-271667.jpeg"
},
{
title: "Office & Commercial Interior Setup",
img: "https://images.pexels.com/photos/374897/pexels-photo-374897.jpeg"
},
{
title: "Luxury & Theme-Based Interiors",
img: "https://images.pexels.com/photos/271805/pexels-photo-271805.jpeg"
},
{
title: "Smart Home Interior Design",
img: "https://images.pexels.com/photos/1080727/pexels-photo-1080727.jpeg"
},
{
title: "Space Planning & Vastu-Based Layouts",
img: "https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg"
}
]; %>
                        <% services.forEach((service, index) => { %>
                        <div class="service-type-card scroll-animate">

                            <!-- Image -->
                            <div class="service-type-image">
                                <img src="<%= service.img %>?auto=compress&cs=tinysrgb&w=900"
                                    alt="<%= service.title %>"
                                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" />

                                <!-- Gradient Overlay -->
                                <div
                                    class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent">
                                </div>

                                <!-- Number Badge -->
                                <div
                                    class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded-full text-sm font-semibold text-gray-800">
                                    <%= index + 1 < 10 ? `0${index + 1}` : index + 1 %>
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="service-type-content">
                                <h3>
                                    <%= service.title %>
                                </h3>

                                <div class="w-14 h-0.5 bg-black rounded-full">
                                </div>
                            </div>

                        </div>
                        <% }) %>
                    </div>

                </div>
            </section>



            <div class="service-types-grid">
                <div class="service-type-card scroll-animate">
                    <div class="service-type-image">
                        <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80"
                            alt="Residential Interior Design">
                    </div>
                    <div class="service-type-content">
                        <h3>Residential Interior Design</h3>
                        <p>Complete home interior solutions including living
                            rooms, bedrooms, kitchens, and bathrooms. We create
                            comfortable and stylish living spaces.</p>
                        <ul class="service-type-features">
                            <li>Living Room Design</li>
                            <li>Bedroom Interiors</li>
                            <li>Kitchen Design</li>
                            <li>Bathroom Interiors</li>
                            <li>Home Office Setup</li>
                        </ul>
                    </div>
                </div>

                <div class="service-type-card scroll-animate delay-1">
                    <div class="service-type-image">
                        <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80"
                            alt="Commercial Interior Design">
                    </div>
                    <div class="service-type-content">
                        <h3>Commercial Interior Design</h3>
                        <p>Professional office and commercial space design that
                            enhances productivity and creates impressive
                            business environments.</p>
                        <ul class="service-type-features">
                            <li>Office Interior Design</li>
                            <li>Retail Store Design</li>
                            <li>Restaurant Interiors</li>
                            <li>Hotel Design</li>
                            <li>Showroom Design</li>
                        </ul>
                    </div>
                </div>

                <div class="service-type-card scroll-animate delay-2">
                    <div class="service-type-image">
                        <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80"
                            alt="Luxury Interior Design">
                    </div>
                    <div class="service-type-content">
                        <h3>Luxury Interior Design</h3>
                        <p>High-end luxury interiors with premium materials,
                            custom furniture, and exclusive design elements for
                            discerning clients.</p>
                        <ul class="service-type-features">
                            <li>Premium Material Selection</li>
                            <li>Custom Furniture Design</li>
                            <li>Luxury Lighting Solutions</li>
                            <li>Art & Decor Curation</li>
                            <li>Smart Home Integration</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Design Process -->
    <section class="design-process section-padding">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-label">Our Process</span>
                <h2 class="section-title">How We Design Your Dream Interior</h2>
            </div>

            <div class="process-steps">
                <div class="process-step scroll-animate">
                    <div class="step-number">01</div>
                    <div class="step-icon">
                        <i class="fas fa-comments"></i>
                    </div>
                    <h3>Consultation & Brief</h3>
                    <p>Understanding your lifestyle, preferences, and
                        requirements through detailed discussions.</p>
                </div>

                <div class="process-step scroll-animate delay-1">
                    <div class="step-number">02</div>
                    <div class="step-icon">
                        <i class="fas fa-ruler-combined"></i>
                    </div>
                    <h3>Space Planning</h3>
                    <p>Analyzing the space and creating optimal layouts for
                        functionality and flow.</p>
                </div>

                <div class="process-step scroll-animate delay-2">
                    <div class="step-number">03</div>
                    <div class="step-icon">
                        <i class="fas fa-palette"></i>
                    </div>
                    <h3>Design Development</h3>
                    <p>Creating design concepts, color schemes, and material
                        selections.</p>
                </div>

                <div class="process-step scroll-animate delay-3">
                    <div class="step-number">04</div>
                    <div class="step-icon">
                        <i class="fas fa-cube"></i>
                    </div>
                    <h3>3D Visualization</h3>
                    <p>Presenting realistic 3D renders and virtual walkthroughs
                        of your space.</p>
                </div>

                <div class="process-step scroll-animate delay-4">
                    <div class="step-number">05</div>
                    <div class="step-icon">
                        <i class="fas fa-tools"></i>
                    </div>
                    <h3>Implementation</h3>
                    <p>Professional execution with quality materials and skilled
                        craftsmanship.</p>
                </div>

                <div class="process-step scroll-animate delay-5">
                    <div class="step-number">06</div>
                    <div class="step-icon">
                        <i class="fas fa-key"></i>
                    </div>
                    <h3>Final Styling</h3>
                    <p>Adding finishing touches, decor, and styling to complete
                        your dream interior.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Portfolio Gallery -->
    <section class="portfolio-gallery section-padding bg-light">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-label">Our Work</span>
                <h2 class="section-title">Interior Design Portfolio</h2>
                <p class="section-description">
                    Explore our collection of stunning interior design projects
                </p>
            </div>

            <div class="portfolio-grid">
                <div class="portfolio-item scroll-animate">
                    <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80"
                        alt="Modern Living Room Design">
                    <div class="portfolio-overlay">
                        <h4>Modern Living Room</h4>
                        <p>Contemporary design with clean lines</p>
                    </div>
                </div>

                <div class="portfolio-item scroll-animate delay-1">
                    <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80"
                        alt="Luxury Bedroom Interior">
                    <div class="portfolio-overlay">
                        <h4>Luxury Bedroom</h4>
                        <p>Elegant and comfortable bedroom design</p>
                    </div>
                </div>

                <div class="portfolio-item scroll-animate delay-2">
                    <img src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80"
                        alt="Modern Kitchen Design">
                    <div class="portfolio-overlay">
                        <h4>Modern Kitchen</h4>
                        <p>Functional and stylish kitchen design</p>
                    </div>
                </div>

                <div class="portfolio-item scroll-animate delay-3">
                    <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80"
                        alt="Office Interior Design">
                    <div class="portfolio-overlay">
                        <h4>Office Interior</h4>
                        <p>Professional workspace design</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="why-choose section-padding">
        <div class="container">
            <div class="section-header text-center">
                <span class="section-label">Why Choose Us</span>
                <h2 class="section-title">Excellence in Interior Design</h2>
            </div>

            <div class="why-choose-grid">
                <div class="why-choose-item scroll-animate">
                    <div class="why-icon">
                        <i class="fas fa-award"></i>
                    </div>
                    <h4>Award-Winning Designs</h4>
                    <p>Recognized for excellence in interior design with
                        multiple industry awards</p>
                </div>

                <div class="why-choose-item scroll-animate delay-1">
                    <div class="why-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h4>Expert Team</h4>
                    <p>Experienced interior designers and project managers
                        dedicated to your project</p>
                </div>

                <div class="why-choose-item scroll-animate delay-2">
                    <div class="why-icon">
                        <i class="fas fa-gem"></i>
                    </div>
                    <h4>Premium Quality</h4>
                    <p>Only the finest materials and finishes for lasting beauty
                        and durability</p>
                </div>

                <div class="why-choose-item scroll-animate delay-3">
                    <div class="why-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h4>Client Satisfaction</h4>
                    <p>100% client satisfaction with personalized service and
                        attention to detail</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section section-padding bg-primary text-white">
        <div class="container">
            <div class="cta-content text-center">
                <h2>Ready to Transform Your Interior?</h2>
                <p>Let's create beautiful and functional interiors that reflect
                    your style and personality.</p>
                <div class="cta-buttons">
                    <a href="/quote" class="btn btn-white btn-large">Get Free
                        Quote</a>
                    <a href="/contact"
                        class="btn btn-outline-white btn-large">Schedule
                        Consultation</a>
                </div>
            </div>
        </div>
    </section>
    <%- include('../partials/footer.ejs') %>
    <script src="/js/main.js"></script>
    <script src="/js/animations.js"></script>
</body>

</html>