<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Architectural Planning Services | Nostrum Dream Spaces</title>

  <meta name="description"
    content="Architectural Planning Services by Nostrum Dream Spaces – 3D Walkthroughs, Vastu Consultation, Turnkey Projects & Material Supply.">

  <meta name="keywords"
    content="architectural planning, 3D walkthrough, vastu consultation, turnkey interiors, material supply">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/animations.css">
  <link rel="stylesheet" href="/css/responsive.css">

  <link rel="icon" href="/images/icon.png">
</head>

<body>

  <%- include('../partials/header.ejs') %>

  <!-- PAGE HEADER -->
  <section class="page-header section-padding bg-dark text-white" style="margin-top:75px;">
    <div class="container">
      <div class="page-header-content text-center">
        <h1 class="page-title animate-fade-up">Architectural Planning Services</h1>
        <p class="page-subtitle animate-fade-up delay-1">
          Smart planning. Visual clarity. End-to-end execution.
        </p>
        <nav class="breadcrumb animate-fade-up delay-2">
          <a href="/">Home</a> / <a href="/services">Services</a> /
          <span>Architectural Planning</span>
        </nav>
      </div>
    </div>
  </section>

  <!-- SERVICE OVERVIEW -->
  <section class="service-overview section-padding">
    <div class="container">
      <div class="row align-center">

        <div class="col-lg-6">
          <div class="service-content scroll-animate-left">
            <span class="section-label">Design Intelligence</span>
            <h2 class="section-title">Comprehensive Architectural Planning</h2>

            <p class="section-description">
              Our architectural planning services bridge creativity and practicality.
              From conceptual layouts to detailed 3D walkthroughs and turnkey execution,
              we ensure your project is planned to perfection.
            </p>

            <div class="service-features">
              <div class="feature-item">
                <i class="fas fa-drafting-compass"></i>
                <div>
                  <h4>Strategic Planning</h4>
                  <p>Optimized layouts with functional zoning and space utilization</p>
                </div>
              </div>

              <div class="feature-item">
                <i class="fas fa-cube"></i>
                <div>
                  <h4>3D Visualization</h4>
                  <p>High-quality renders and walkthroughs for complete clarity</p>
                </div>
              </div>

              <div class="feature-item">
                <i class="fas fa-handshake"></i>
                <div>
                  <h4>Turnkey Expertise</h4>
                  <p>Single-point responsibility from planning to execution</p>
                </div>
              </div>
            </div>

          </div>
        </div>

        <div class="col-lg-6">
          <div class="service-image scroll-animate-right">
            <img
              src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=900&q=80"
              alt="Architectural Planning" class="img-fluid">
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SERVICE TYPES -->
  <section class="service-types section-padding bg-light">
    <div class="container">

      <div class="section-header text-center">
        <span class="section-label">Our Expertise</span>
        <h2 class="section-title">Architectural Services We Provide</h2>
        <p class="section-description">
          End-to-end architectural solutions for residential, commercial & turnkey projects
        </p>
      </div>

      <div class="service-types-grid">

        <div class="service-type-card scroll-animate">
          <div class="service-type-image">
            <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=900&q=80">
            <div class="badge">01</div>
          </div>
          <div class="service-type-content">
            <h3>3D Walkthrough & Rendering</h3>
            <div class="divider"></div>
          </div>
        </div>

        <div class="service-type-card scroll-animate delay-1">
          <div class="service-type-image">
            <img src="data:image/jpeg;base64,">
            <div class="badge">02</div>
          </div>
          <div class="service-type-content">
            <h3>Vastu Consultation</h3>
            <div class="divider"></div>
          </div>
        </div>

        <div class="service-type-card scroll-animate delay-2">
          <div class="service-type-image">
            <img src="https://images.unsplash.com/photo-1600585152220-90363fe7e115?auto=format&fit=crop&w=900&q=80">
            <div class="badge">03</div>
          </div>
          <div class="service-type-content">
            <h3>Turnkey Interior Projects</h3>
            <div class="divider"></div>
          </div>
        </div>

        <div class="service-type-card scroll-animate delay-3">
          <div class="service-type-image">
            <img src="data:image/jpeg;base64,">
            <div class="badge">04</div>
          </div>
          <div class="service-type-content">
            <h3>Material Supply (Tiles, Marble, Sanitary, etc.)</h3>
            <div class="divider"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="installation-process section-padding">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-label">Our Workflow</span>
        <h2 class="section-title">Architectural Planning Process</h2>
      </div>

      <div class="process-steps">

        <div class="process-step scroll-animate">
          <div class="step-number">01</div>
          <i class="fas fa-comments step-icon"></i>
          <h3>Requirement Discussion</h3>
          <p>Understanding vision, budget, and project scope</p>
        </div>

        <div class="process-step scroll-animate delay-1">
          <div class="step-number">02</div>
          <!-- <i class="fas fa-pencil-ruler step-icon"></i> -->
          <h3>Concept Planning</h3>
          <p>Initial layouts and planning concepts</p>
        </div>

        <div class="process-step scroll-animate delay-2">
          <div class="step-number">03</div>
          <i class="fas fa-cube step-icon"></i>
          <h3>3D Visualization</h3>
          <p>Realistic renders & walkthroughs</p>
        </div>

        <div class="process-step scroll-animate delay-3">
          <div class="step-number">04</div>
          <!-- <i class="fas fa-check step-icon"></i> -->
          <h3>Finalization</h3>
          <p>Design approval & material selection</p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section section-padding bg-primary text-white">
    <div class="container">
      <div class="cta-content text-center">
        <h2>Plan It Right from the Start</h2>
        <p>Get expert architectural planning that saves time, cost, and mistakes.</p>
        <div class="cta-buttons">
          <a href="/quote" class="btn btn-white btn-large">Get Consultation</a>
          <a href="/contact" class="btn btn-outline-white btn-large">Talk to Architect</a>
        </div>
      </div>
    </div>
  </section>

  <%- include('../partials/footer.ejs') %>

  <script src="/js/main.js"></script>
  <script src="/js/animations.js"></script>
</body>

</html>
