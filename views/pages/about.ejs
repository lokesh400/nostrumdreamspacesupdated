<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us || Nostrum Dream Spaces</title>
    <meta name="description"
        content="Nostrum Dream Spaces - Premium Interior Design, Exterior Design, Construction & Turnkey Solutions. Designing Dreams. Building Reality.">
    <meta name="keywords"
        content="interior design, exterior design, construction, turnkey projects, modular kitchen, renovation, premium design">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Styles -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/animations.css">
    <link rel="stylesheet" href="/css/responsive.css">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/logo.png">
</head>

<body style="width: 100%;">

    <%- include('../partials/header.ejs') %>
<section class="page-header section-padding bg-dark text-white" style="margin-top: 75px;">
    <div class="container">
        <div class="page-header-content text-center">
            <h1 class="page-title animate-fade-up">About Nostrum Dream Spaces</h1>
            <p class="page-subtitle animate-fade-up delay-1">Crafting exceptional spaces with passion, precision, and purpose</p>
            <nav class="breadcrumb animate-fade-up delay-2">
                <a href="/">Home</a> / <span>About Us</span>
            </nav>
        </div>
    </div>
</section>

<!-- Company Story Section -->
<section class="company-story section-padding">
    <div class="container">
        <div class="row align-center">
            <div class="col-lg-6">
                <div class="story-content scroll-animate-left">
                    <span class="section-label">Our Story</span>
                    <h2 class="section-title">Building Dreams Since 2022</h2>
                    <p class="section-description">
                        Founded with a vision to transform spaces into extraordinary experiences, 
                        Nostrum Dream Spaces has been at the forefront of interior design and 
                        construction excellence for over 4 years.
                    </p>
                    <p>
                        What started as a passionate design studio has evolved into a comprehensive 
                        design and construction company, serving clients across residential and 
                        commercial sectors. Our journey has been marked by innovation, quality, 
                        and an unwavering commitment to client satisfaction.
                    </p>
                    <div class="story-highlights">
                        <div class="highlight-item">
                            <div class="highlight-number counter" data-target="100">0</div>
                            <div class="highlight-text">Projects Completed</div>
                        </div>
                        <div class="highlight-item">
                            <div class="highlight-number counter" data-target="2">0</div>
                            <div class="highlight-text">Years of Excellence</div>
                        </div>
                        <div class="highlight-item">
                            <div class="highlight-number counter" data-target="15">0</div>
                            <div class="highlight-text">Expert Team Members</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="story-image scroll-animate-right">
                    <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Nostrum Dream Spaces Story" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Vision & Mission Section -->
<section class="vision-mission section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Vision & Mission</span>
            <h2 class="section-title">Our Purpose & Direction</h2>
        </div>
        
        <div class="vm-grid">
            <div class="vm-card scroll-animate">
                <div class="vm-icon">
                    <i class="fas fa-eye"></i>
                </div>
                <h3>Our Vision</h3>
                <p>
                    To be the leading design and construction company that transforms 
                    spaces into inspiring environments, setting new standards of 
                    excellence in the industry while creating lasting value for our clients.
                </p>
            </div>
            
            <div class="vm-card scroll-animate delay-1">
                <div class="vm-icon">
                    <i class="fas fa-bullseye"></i>
                </div>
                <h3>Our Mission</h3>
                <p>
                    To deliver exceptional design and construction solutions that exceed 
                    client expectations through innovation, quality craftsmanship, and 
                    personalized service, while maintaining the highest standards of 
                    integrity and professionalism.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Core Values Section -->
<section class="core-values section-padding">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Core Values</span>
            <h2 class="section-title">What Drives Us</h2>
            <p class="section-description">
                Our values form the foundation of everything we do, guiding our 
                decisions and shaping our relationships with clients and partners.
            </p>
        </div>
        
        <div class="values-grid">
            <div class="value-card scroll-animate">
                <div class="value-icon">
                    <i class="fas fa-gem"></i>
                </div>
                <h4>Excellence</h4>
                <p>We strive for perfection in every project, never compromising on quality or attention to detail.</p>
            </div>
            
            <div class="value-card scroll-animate delay-1">
                <div class="value-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <h4>Innovation</h4>
                <p>We embrace new technologies and creative solutions to deliver cutting-edge design experiences.</p>
            </div>
            
            <div class="value-card scroll-animate delay-2">
                <div class="value-icon">
                    <i class="fas fa-handshake"></i>
                </div>
                <h4>Integrity</h4>
                <p>We conduct business with honesty, transparency, and ethical practices in all our interactions.</p>
            </div>
            
            <div class="value-card scroll-animate delay-3">
                <div class="value-icon">
                    <i class="fas fa-users"></i>
                </div>
                <h4>Collaboration</h4>
                <p>We work closely with clients and partners to achieve shared goals and mutual success.</p>
            </div>
            
            <div class="value-card scroll-animate delay-4">
                <div class="value-icon">
                    <i class="fas fa-leaf"></i>
                </div>
                <h4>Sustainability</h4>
                <p>We are committed to environmentally responsible practices and sustainable design solutions.</p>
            </div>
            
            <div class="value-card scroll-animate delay-5">
                <div class="value-icon">
                    <i class="fas fa-heart"></i>
                </div>
                <h4>Passion</h4>
                <p>We bring enthusiasm and dedication to every project, treating each space as our own.</p>
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="team-section section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Team</span>
            <h2 class="section-title">Meet the Experts</h2>
            <p class="section-description">
                Our talented team of architects, designers, and craftsmen brings 
                years of experience and passion to every project.
            </p>
        </div>
        
        <div class="team-grid">
            <div class="team-member scroll-animate">
                <div class="member-image">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="Rajesh Gupta">
                    <div class="member-overlay">
                        <div class="social-links">
                            <a href="#"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#"><i class="fab fa-twitter"></i></a>
                            <a href="#"><i class="fas fa-envelope"></i></a>
                        </div>
                    </div>
                </div>
                <div class="member-info">
                    <h4>Rajesh Gupta</h4>
                    <span class="member-role">Founder & Principal Architect</span>
                    <p>With over 5 years of experience in architectural design and project management.</p>
                </div>
            </div>
            
            <div class="team-member scroll-animate delay-1">
                <div class="member-image">
                    <img src="https://images.unsplash.com/photo-1494790108755-2616b612b786?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="Priya Sharma">
                    <div class="member-overlay">
                        <div class="social-links">
                            <a href="#"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#"><i class="fab fa-instagram"></i></a>
                            <a href="#"><i class="fas fa-envelope"></i></a>
                        </div>
                    </div>
                </div>
                <div class="member-info">
                    <h4>Priya Sharma</h4>
                    <span class="member-role">Lead Interior Designer</span>
                    <p>Specializes in luxury residential and commercial interior design with a modern aesthetic.</p>
                </div>
            </div>
            
            <div class="team-member scroll-animate delay-2">
                <div class="member-image">
                    <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="Amit Patel">
                    <div class="member-overlay">
                        <div class="social-links">
                            <a href="#"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#"><i class="fab fa-behance"></i></a>
                            <a href="#"><i class="fas fa-envelope"></i></a>
                        </div>
                    </div>
                </div>
                <div class="member-info">
                    <h4>Amit Patel</h4>
                    <span class="member-role">Construction Manager</span>
                    <p>Ensures quality execution and timely completion of all construction projects.</p>
                </div>
            </div>
            
            <div class="team-member scroll-animate delay-3">
                <div class="member-image">
                    <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" alt="Sneha Reddy">
                    <div class="member-overlay">
                        <div class="social-links">
                            <a href="#"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#"><i class="fab fa-pinterest"></i></a>
                            <a href="#"><i class="fas fa-envelope"></i></a>
                        </div>
                    </div>
                </div>
                <div class="member-info">
                    <h4>Sneha Reddy</h4>
                    <span class="member-role">Project Coordinator</span>
                    <p>Manages client relationships and ensures smooth project coordination from start to finish.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section section-padding bg-primary text-white">
    <div class="container">
        <div class="cta-content text-center">
            <h2>Ready to Start Your Dream Project?</h2>
            <p>Let's collaborate to create spaces that inspire and delight. Contact us today for a consultation.</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-white btn-large">Get In Touch</a>
                <a href="/portfolio" class="btn btn-outline-white btn-large">View Our Work</a>
            </div>
        </div>
    </div>
</section>

        <%- include('../partials/footer.ejs') %>

            <script src="/js/main.js"></script>
            <script src="/js/animations.js"></script>
</body>

</html>
