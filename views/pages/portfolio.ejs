<body style="width: 100%;">

    <%- include('../partials/header.ejs') %>
<section class="page-header section-padding bg-dark text-white" style="margin-top: 75px;">
    <div class="container">
        <div class="page-header-content text-center">
            <h1 class="page-title animate-fade-up">Our Portfolio</h1>
            <p class="page-subtitle animate-fade-up delay-1">Explore our collection of exceptional design and construction projects</p>
            <nav class="breadcrumb animate-fade-up delay-2">
                <a href="/">Home</a> / <span>Portfolio</span>
            </nav>
        </div>
    </div>
</section>

<!-- Portfolio Stats -->
<section class="portfolio-stats section-padding">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-card scroll-animate">
                <div class="stat-number counter" data-target="100">0</div>
                <div class="stat-label">Projects Completed</div>
            </div>
            <div class="stat-card scroll-animate delay-1">
                <div class="stat-number counter" data-target="50">0</div>
                <div class="stat-label">Happy Clients</div>
            </div>
            <div class="stat-card scroll-animate delay-2">
                <div class="stat-number counter" data-target="2">0</div>
                <div class="stat-label">Years Experience</div>
            </div>
            <div class="stat-card scroll-animate delay-3">
                <div class="stat-number counter" data-target="15">0</div>
                <div class="stat-label">Team Members</div>
            </div>
        </div>
    </div>
</section>

