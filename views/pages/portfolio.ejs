<!-- Project Categories -->
<section class="project-categories section-padding">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Project Types</span>
            <h2 class="section-title">What We Specialize In</h2>
        </div>
        
        <div class="categories-grid">
            <div class="category-card scroll-animate">
                <div class="category-icon">
                    <i class="fas fa-home"></i>
                </div>
                <h4>Residential Projects</h4>
                <p>Luxury villas, apartments, and custom homes with premium interior and exterior design</p>
                <div class="category-count">65+ Projects</div>
            </div>
            
            <div class="category-card scroll-animate delay-1">
                <div class="category-icon">
                    <i class="fas fa-building"></i>
                </div>
                <h4>Commercial Projects</h4>
                <p>Offices, retail stores, restaurants, and commercial buildings with professional design</p>
                <div class="category-count">35+ Projects</div>
            </div>
            
            <div class="category-card scroll-animate delay-2">
                <div class="category-icon">
                    <i class="fas fa-hammer"></i>
                </div>
                <h4>Construction Projects</h4>
                <p>Complete construction and turnkey solutions from foundation to finishing</p>
                <div class="category-count">40+ Projects</div>
            </div>
            
            <div class="category-card scroll-animate delay-3">
                <div class="category-icon">
                    <i class="fas fa-kitchen-set"></i>
                </div>
                <h4>Modular Works</h4>
                <p>Custom modular kitchens, wardrobes, and furniture solutions</p>
                <div class="category-count">80+ Projects</div>
            </div>
        </div>
    </div>
</section>

