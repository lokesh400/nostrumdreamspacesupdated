<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nostrum Dream Spaces</title>
    <meta name="description"
        content="Nostrum Dream Spaces - Premium Interior Design, Exterior Design, Construction & Turnkey Solutions. Designing Dreams. Building Reality.">
    <meta name="keywords"
        content="interior design, exterior design, construction, turnkey projects, modular kitchen, renovation, premium design">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Styles -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/animations.css">
    <link rel="stylesheet" href="/css/responsive.css">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body style="width: 100%;">

    <%- include('../partials/header.ejs') %>
<section class="page-header section-padding bg-dark text-white" style="margin-top: 75px;">
    <div class="container">
        <div class="page-header-content text-center">
            <h1 class="page-title animate-fade-up">Plumbing & Waterproofing Services</h1>
            <p class="page-subtitle animate-fade-up delay-1">Complete plumbing solutions and waterproofing protection</p>
            <nav class="breadcrumb animate-fade-up delay-2">
                <a href="/">Home</a> / <a href="/services">Services</a> / <span>Plumbing & Waterproofing</span>
            </nav>
        </div>
    </div>
</section>

<!-- Service Overview -->
<section class="service-overview section-padding">
    <div class="container">
        <div class="row align-center">
            <div class="col-lg-6">
                <div class="service-content scroll-animate-left">
                    <span class="section-label">Plumbing Excellence</span>
                    <h2 class="section-title">Professional Plumbing & Waterproofing</h2>
                    <p class="section-description">
                        Our plumbing and waterproofing services ensure reliable water supply, efficient drainage, 
                        and complete protection against water damage. We provide comprehensive solutions for 
                        residential and commercial properties with quality materials and expert installation.
                    </p>
                    <div class="service-features">
                        <div class="feature-item">
                            <i class="fas fa-wrench"></i>
                            <div>
                                <h4>Expert Installation</h4>
                                <p>Professional plumbing installation by certified technicians</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <h4>Leak Protection</h4>
                                <p>Advanced waterproofing solutions for complete leak protection</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <i class="fas fa-clock"></i>
                            <div>
                                <h4>24/7 Support</h4>
                                <p>Emergency plumbing services and maintenance support</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="service-image scroll-animate-right">
                    <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Modern Bathroom Plumbing" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Service Types -->
<section class="service-types section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Services</span>
            <h2 class="section-title">Plumbing & Waterproofing Solutions</h2>
            <p class="section-description">
                Comprehensive plumbing and waterproofing services for all your needs
            </p>
        </div>
        
        <div class="service-types-grid">
            <div class="service-type-card scroll-animate">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Plumbing Installation">
                </div>
                <div class="service-type-content">
                    <h3>Plumbing Installation</h3>
                    <p>Complete plumbing system installation for new constructions and renovations with quality pipes and fittings.</p>
                    <ul class="service-features">
                        <li>Water Supply Systems</li>
                        <li>Drainage Systems</li>
                        <li>Pipe Installation</li>
                        <li>Fixture Installation</li>
                        <li>Gas Line Installation</li>
                    </ul>
                </div>
            </div>
            
            <div class="service-type-card scroll-animate delay-1">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1620626011761-996317b8d101?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Bathroom Fitting">
                </div>
                <div class="service-type-content">
                    <h3>Bathroom Fitting</h3>
                    <p>Complete bathroom plumbing solutions including sanitary ware installation and modern fixtures.</p>
                    <ul class="service-features">
                        <li>Toilet Installation</li>
                        <li>Basin & Sink Fitting</li>
                        <li>Shower Systems</li>
                        <li>Bathtub Installation</li>
                        <li>Faucet & Mixer Installation</li>
                    </ul>
                </div>
            </div>
            
            <div class="service-type-card scroll-animate delay-2">
                <div class="service-type-image">
                    <img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Waterproofing">
                </div>
                <div class="service-type-content">
                    <h3>Waterproofing Solutions</h3>
                    <p>Advanced waterproofing treatments for terraces, basements, bathrooms, and external walls.</p>
                    <ul class="service-features">
                        <li>Terrace Waterproofing</li>
                        <li>Basement Waterproofing</li>
                        <li>Bathroom Waterproofing</li>
                        <li>External Wall Treatment</li>
                        <li>Leak Repair Services</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Waterproofing Types -->
<section class="waterproofing-types section-padding">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Waterproofing Solutions</span>
            <h2 class="section-title">Types of Waterproofing We Provide</h2>
        </div>
        
        <div class="waterproofing-grid">
            <div class="waterproofing-card scroll-animate">
                <div class="waterproofing-icon">
                    <i class="fas fa-home"></i>
                </div>
                <h4>Terrace Waterproofing</h4>
                <p>Complete terrace protection against monsoon and weather damage with advanced membrane systems</p>
            </div>
            
            <div class="waterproofing-card scroll-animate delay-1">
                <div class="waterproofing-icon">
                    <i class="fas fa-building"></i>
                </div>
                <h4>Basement Waterproofing</h4>
                <p>Basement protection against groundwater seepage and moisture with crystalline waterproofing</p>
            </div>
            
            <div class="waterproofing-card scroll-animate delay-2">
                <div class="waterproofing-icon">
                    <i class="fas fa-bath"></i>
                </div>
                <h4>Bathroom Waterproofing</h4>
                <p>Complete bathroom waterproofing to prevent leaks and water damage to adjacent areas</p>
            </div>
            
            <div class="waterproofing-card scroll-animate delay-3">
                <div class="waterproofing-icon">
                    <i class="fas fa-wall-brick"></i>
                </div>
                <h4>External Wall Treatment</h4>
                <p>External wall waterproofing to protect against rain penetration and structural damage</p>
            </div>
            
            <div class="waterproofing-card scroll-animate delay-4">
                <div class="waterproofing-icon">
                    <i class="fas fa-swimming-pool"></i>
                </div>
                <h4>Swimming Pool Waterproofing</h4>
                <p>Specialized waterproofing solutions for swimming pools and water features</p>
            </div>
            
            <div class="waterproofing-card scroll-animate delay-5">
                <div class="waterproofing-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <h4>Leak Repair Services</h4>
                <p>Expert leak detection and repair services for existing waterproofing failures</p>
            </div>
        </div>
    </div>
</section>

<!-- Plumbing Materials -->
<section class="plumbing-materials section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Quality Materials</span>
            <h2 class="section-title">Premium Plumbing Materials We Use</h2>
        </div>
        
        <div class="materials-grid">
            <div class="material-card scroll-animate">
                <div class="material-icon">
                    <i class="fas fa-pipe"></i>
                </div>
                <h4>CPVC & PVC Pipes</h4>
                <p>High-quality CPVC and PVC pipes for hot and cold water supply systems</p>
            </div>
            
            <div class="material-card scroll-animate delay-1">
                <div class="material-icon">
                    <i class="fas fa-faucet"></i>
                </div>
                <h4>Premium Fixtures</h4>
                <p>Top-brand sanitary ware and fixtures from leading manufacturers</p>
            </div>
            
            <div class="material-card scroll-animate delay-2">
                <div class="material-icon">
                    <i class="fas fa-valve"></i>
                </div>
                <h4>Quality Valves</h4>
                <p>Durable valves and fittings for reliable water flow control</p>
            </div>
            
            <div class="material-card scroll-animate delay-3">
                <div class="material-icon">
                    <i class="fas fa-shield-virus"></i>
                </div>
                <h4>Waterproofing Chemicals</h4>
                <p>Advanced waterproofing chemicals and membranes for lasting protection</p>
            </div>
        </div>
    </div>
</section>

<!-- Installation Process -->
<section class="installation-process section-padding">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Process</span>
            <h2 class="section-title">Professional Installation Process</h2>
        </div>
        
        <div class="process-steps">
            <div class="process-step scroll-animate">
                <div class="step-number">01</div>
                <div class="step-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3>Site Inspection</h3>
                <p>Thorough inspection of the site to assess plumbing requirements and challenges.</p>
            </div>
            
            <div class="process-step scroll-animate delay-1">
                <div class="step-number">02</div>
                <div class="step-icon">
                    <i class="fas fa-drafting-compass"></i>
                </div>
                <h3>System Design</h3>
                <p>Designing the plumbing layout and waterproofing plan based on requirements.</p>
            </div>
            
            <div class="process-step scroll-animate delay-2">
                <div class="step-number">03</div>
                <div class="step-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <h3>Material Procurement</h3>
                <p>Sourcing high-quality materials and fixtures from trusted suppliers.</p>
            </div>
            
            <div class="process-step scroll-animate delay-3">
                <div class="step-number">04</div>
                <div class="step-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <h3>Professional Installation</h3>
                <p>Expert installation by certified plumbers following industry standards.</p>
            </div>
            
            <div class="process-step scroll-animate delay-4">
                <div class="step-number">05</div>
                <div class="step-icon">
                    <i class="fas fa-vial"></i>
                </div>
                <h3>Testing & Commissioning</h3>
                <p>Comprehensive testing of all systems to ensure proper functioning.</p>
            </div>
            
            <div class="process-step scroll-animate delay-5">
                <div class="step-number">06</div>
                <div class="step-icon">
                    <i class="fas fa-handshake"></i>
                </div>
                <h3>Handover & Support</h3>
                <p>Final handover with maintenance guidelines and ongoing support.</p>
            </div>
        </div>
    </div>
</section>

<!-- Portfolio Gallery -->
<section class="portfolio-gallery section-padding bg-light">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-label">Our Work</span>
            <h2 class="section-title">Plumbing & Waterproofing Portfolio</h2>
            <p class="section-description">
                Explore our collection of plumbing and waterproofing projects
            </p>
        </div>
        
        <div class="portfolio-grid">
            <div class="portfolio-item scroll-animate">
                <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Modern Bathroom Plumbing">
                <div class="portfolio-overlay">
                    <h4>Modern Bathroom</h4>
                    <p>Complete bathroom plumbing installation</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-1">
                <img src="https://images.unsplash.com/photo-1620626011761-996317b8d101?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Luxury Bathroom Fitting">
                <div class="portfolio-overlay">
                    <h4>Luxury Bathroom Fitting</h4>
                    <p>Premium sanitary ware installation</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-2">
                <img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Terrace Waterproofing">
                <div class="portfolio-overlay">
                    <h4>Terrace Waterproofing</h4>
                    <p>Complete terrace waterproofing solution</p>
                </div>
            </div>
            
            <div class="portfolio-item scroll-animate delay-3">
                <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="Kitchen Plumbing">
                <div class="portfolio-overlay">
                    <h4>Kitchen Plumbing</h4>
                    <p>Modern kitchen plumbing installation</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section section-padding bg-primary text-white">
    <div class="container">
        <div class="cta-content text-center">
            <h2>Need Reliable Plumbing & Waterproofing Solutions?</h2>
            <p>Let's protect your property with professional plumbing and waterproofing services.</p>
            <div class="cta-buttons">
                <a href="/quote" class="btn btn-white btn-large">Get Free Quote</a>
                <a href="/contact" class="btn btn-outline-white btn-large">Emergency Service</a>
            </div>
        </div>
    </div>
</section>

        <%- include('../partials/footer.ejs') %>

            <script src="/js/main.js"></script>
            <script src="/js/animations.js"></script>
</body>

</html>